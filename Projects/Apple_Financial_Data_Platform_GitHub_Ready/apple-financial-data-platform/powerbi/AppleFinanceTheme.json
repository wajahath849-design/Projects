{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.156.json",
  "name": "Apple Financial Reporting",
  "dataColors": [
    "#1D1D1F",
    "#6E6E73",
    "#0071E3",
    "#34C759",
    "#FF9F0A",
    "#FF3B30",
    "#AF52DE",
    "#5AC8FA"
  ],
  "background": "#F5F5F7",
  "foreground": "#1D1D1F",
  "tableAccent": "#0071E3",
  "good": "#34C759",
  "neutral": "#FF9F0A",
  "bad": "#FF3B30",
  "maximum": "#0071E3",
  "center": "#E8E8ED",
  "minimum": "#FF3B30",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#1D1D1F"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#1D1D1F"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1D1D1F"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#6E6E73"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E5EA"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#1D1D1F"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F5F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
