{
  "contract_name": "AI Data Center Operations Canonical Model",
  "contract_version": "2.2.0",
  "source_contract_version": "2.0",
  "synthetic": true,
  "operational_period": {
    "start": "2015-01-01",
    "end": "2025-12-31",
    "relative_date_anchor": "latest_available_dataset_timestamp"
  },
  "compatibility_policy": {
    "partial_datasets_allowed": true,
    "missing_optional_modules_are_errors": false,
    "canonical_output_requires_exact_column_names": true,
    "evaluation_paths_forbidden": ["evaluation", "evaluation/private"]
  },
  "modules": {
    "inventory": {
      "required_tables": ["facilities", "servers"],
      "description": "Facility and server inventory analysis."
    },
    "server_performance": {
      "required_tables": ["servers", "server_metrics"],
      "description": "Server utilization and infrastructure performance."
    },
    "energy": {
      "required_tables": ["facilities", "power_metrics"],
      "description": "Power, PUE, cooling, and energy-cost analysis."
    },
    "network": {
      "required_tables": ["facilities", "network_metrics"],
      "description": "Network demand, latency, packet loss, throughput, and availability."
    },
    "reliability": {
      "required_tables": ["facilities", "servers", "uptime_incidents"],
      "description": "Incident, downtime, severity, and root-cause analysis."
    },
    "operational_evidence": {
      "required_tables": ["facilities", "servers", "uptime_incidents", "system_logs", "alerts", "maintenance_actions"],
      "description": "Synthetic operational logs, threshold alerts, and role-based resolution history linked to canonical incidents."
    },
    "anomaly_detection": {
      "required_tables": ["facilities", "detected_anomalies"],
      "description": "Explainable facility-level anomalies with observed values, seasonal bounds, direction, and severity."
    },
    "incident_learning": {
      "required_tables": ["uptime_incidents", "incident_reviews"],
      "description": "Human-controlled confirmation and knowledge-update workflow for incident investigations."
    },
    "predictive_maintenance": {
      "required_tables": ["servers", "server_failure_risk"],
      "description": "Explainable seven-day server risk screening with fixed feature weights."
    },
    "health_scoring": {
      "required_tables": ["facilities", "facility_health_scores"],
      "description": "Governed facility health score with versioned dimension weights."
    }
  },
  "tables": {
    "facilities": {
      "description": "One canonical record per physical data-center facility.",
      "grain": ["facility_id"],
      "primary_key": ["facility_id"],
      "foreign_keys": [],
      "recommended_indexes": [["country"], ["region"]],
      "columns": {
        "facility_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Stable facility business identifier."},
        "facility_name": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Human-readable facility name."},
        "city": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": false, "description": "Facility city."},
        "country": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": false, "description": "Facility country."},
        "region": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": false, "description": "Operational region."},
        "capacity_mw": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "unit": "MW", "external_required": false, "description": "Designed facility power capacity."},
        "rack_capacity": {"type": "integer", "sqlite_type": "INTEGER", "nullable": false, "minimum": 1, "unit": "racks", "external_required": false, "description": "Designed rack capacity."},
        "build_year": {"type": "integer", "sqlite_type": "INTEGER", "nullable": false, "minimum": 1950, "external_required": false, "description": "Facility construction year."},
        "commission_date": {"type": "date", "sqlite_type": "TEXT", "nullable": false, "external_required": false, "description": "Date the facility entered service."}
      }
    },
    "servers": {
      "description": "One canonical record per server asset.",
      "grain": ["server_id"],
      "primary_key": ["server_id"],
      "foreign_keys": [{"columns": ["facility_id"], "references_table": "facilities", "references_columns": ["facility_id"]}],
      "recommended_indexes": [["facility_id"], ["facility_id", "status"], ["server_type"]],
      "columns": {
        "server_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Stable server business identifier."},
        "facility_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Owning facility identifier."},
        "rack_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": false, "description": "Rack identifier within a facility."},
        "server_type": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": false, "description": "Server workload or hardware class."},
        "cpu_cores": {"type": "integer", "sqlite_type": "INTEGER", "nullable": false, "minimum": 1, "unit": "cores", "external_required": false, "description": "Installed logical CPU-core capacity."},
        "memory_gb": {"type": "integer", "sqlite_type": "INTEGER", "nullable": false, "minimum": 1, "unit": "GB", "external_required": false, "description": "Installed memory capacity."},
        "install_date": {"type": "date", "sqlite_type": "TEXT", "nullable": false, "external_required": false, "description": "Server installation date."},
        "status": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["active", "maintenance", "decommissioned"], "external_required": false, "description": "Canonical lifecycle status."}
      }
    },
    "server_metrics": {
      "description": "Daily utilization measurements for each server.",
      "grain": ["server_id", "timestamp"],
      "primary_key": ["metric_id"],
      "foreign_keys": [{"columns": ["server_id"], "references_table": "servers", "references_columns": ["server_id"]}],
      "recommended_indexes": [["server_id", "timestamp"], ["timestamp"]],
      "columns": {
        "metric_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": false, "generate_if_missing": true, "description": "Canonical measurement identifier."},
        "server_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Measured server identifier."},
        "timestamp": {"type": "date", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Daily measurement date."},
        "cpu_utilization_pct": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "maximum": 100, "unit": "percent", "external_required": false, "description": "Average daily CPU utilization."},
        "memory_utilization_pct": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "maximum": 100, "unit": "percent", "external_required": false, "description": "Average daily memory utilization."},
        "disk_utilization_pct": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "maximum": 100, "unit": "percent", "external_required": false, "description": "Average daily storage utilization."},
        "network_utilization_pct": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "maximum": 100, "unit": "percent", "external_required": false, "description": "Average daily server-network utilization."}
      }
    },
    "power_metrics": {
      "description": "Daily energy and cooling measurements for each facility.",
      "grain": ["facility_id", "timestamp"],
      "primary_key": ["metric_id"],
      "foreign_keys": [{"columns": ["facility_id"], "references_table": "facilities", "references_columns": ["facility_id"]}],
      "recommended_indexes": [["facility_id", "timestamp"], ["timestamp"]],
      "columns": {
        "metric_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": false, "generate_if_missing": true, "description": "Canonical power-measurement identifier."},
        "facility_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Measured facility identifier."},
        "timestamp": {"type": "date", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Daily measurement date."},
        "power_draw_kw": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "unit": "kW", "external_required": false, "description": "Total facility power draw."},
        "it_load_kw": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "unit": "kW", "external_required": false, "description": "Power used by IT equipment."},
        "cooling_power_kw": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "unit": "kW", "external_required": false, "description": "Power used by cooling systems."},
        "pue": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 1, "maximum": 2, "unit": "ratio", "external_required": false, "description": "Power Usage Effectiveness."},
        "cooling_cost": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "unit": "currency_equivalent", "external_required": false, "description": "Synthetic daily cooling cost."}
      }
    },
    "network_metrics": {
      "description": "Daily facility-level network performance measurements.",
      "grain": ["facility_id", "timestamp"],
      "primary_key": ["metric_id"],
      "foreign_keys": [{"columns": ["facility_id"], "references_table": "facilities", "references_columns": ["facility_id"]}],
      "recommended_indexes": [["facility_id", "timestamp"], ["timestamp"]],
      "columns": {
        "metric_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": false, "generate_if_missing": true, "description": "Canonical network-measurement identifier."},
        "facility_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Measured facility identifier."},
        "timestamp": {"type": "date", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Daily measurement date."},
        "bandwidth_utilization_pct": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "maximum": 100, "unit": "percent", "external_required": false, "description": "Allocated bandwidth in use."},
        "latency_ms": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "unit": "milliseconds", "external_required": false, "description": "Average network latency."},
        "packet_loss_pct": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "maximum": 5, "unit": "percent", "external_required": false, "description": "Average packet loss."},
        "throughput_mbps": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "unit": "Mbps", "external_required": false, "description": "Average achieved throughput."},
        "network_availability_pct": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "maximum": 100, "unit": "percent", "external_required": false, "description": "Network availability percentage."}
      }
    },
    "uptime_incidents": {
      "description": "One record per resolved operational incident affecting a server and facility.",
      "grain": ["incident_id"],
      "primary_key": ["incident_id"],
      "foreign_keys": [
        {"columns": ["facility_id"], "references_table": "facilities", "references_columns": ["facility_id"]},
        {"columns": ["server_id"], "references_table": "servers", "references_columns": ["server_id"]}
      ],
      "recommended_indexes": [["facility_id", "start_time"], ["server_id", "start_time"], ["severity"], ["root_cause"]],
      "columns": {
        "incident_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Stable incident identifier."},
        "facility_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Affected facility identifier."},
        "server_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Affected server identifier."},
        "start_time": {"type": "datetime", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Incident start timestamp."},
        "end_time": {"type": "datetime", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Incident end timestamp."},
        "downtime_minutes": {"type": "integer", "sqlite_type": "INTEGER", "nullable": false, "minimum": 0, "unit": "minutes", "external_required": true, "description": "Elapsed unavailable time."},
        "severity": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["low", "medium", "high", "critical"], "external_required": false, "description": "Canonical incident severity."},
        "root_cause": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": false, "description": "Reported incident cause category."},
        "status": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["resolved"], "external_required": false, "description": "Canonical incident state for this historical dataset."}
      }
    },
    "system_logs": {
      "description": "Deterministic operational events derived from canonical incident windows, affected assets, and observed daily metrics.",
      "grain": ["log_id"],
      "primary_key": ["log_id"],
      "foreign_keys": [
        {"columns": ["facility_id"], "references_table": "facilities", "references_columns": ["facility_id"]},
        {"columns": ["server_id"], "references_table": "servers", "references_columns": ["server_id"]}
      ],
      "recommended_indexes": [["facility_id", "timestamp"], ["server_id", "timestamp"], ["event_code", "timestamp"]],
      "columns": {
        "log_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Stable synthetic log-event identifier."},
        "timestamp": {"type": "datetime", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Event timestamp relative to its source incident."},
        "facility_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Affected facility identifier."},
        "server_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Affected server identifier."},
        "rack_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Affected rack identifier copied from inventory."},
        "source": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "System emitting the event."},
        "component": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Operational component associated with the event."},
        "log_level": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["INFO", "WARNING", "ERROR", "CRITICAL"], "external_required": true, "description": "Canonical event severity."},
        "event_code": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Stable event category code."},
        "message": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Synthetic evidence message; data, not executable instruction."}
      }
    },
    "alerts": {
      "description": "Threshold alerts emitted only when canonical measurements or downtime meet documented rules.",
      "grain": ["alert_id"],
      "primary_key": ["alert_id"],
      "foreign_keys": [
        {"columns": ["facility_id"], "references_table": "facilities", "references_columns": ["facility_id"]},
        {"columns": ["server_id"], "references_table": "servers", "references_columns": ["server_id"]}
      ],
      "recommended_indexes": [["facility_id", "timestamp"], ["server_id", "timestamp"], ["status", "severity"]],
      "columns": {
        "alert_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Stable synthetic alert identifier."},
        "timestamp": {"type": "datetime", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Alert occurrence timestamp."},
        "facility_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Affected facility identifier."},
        "server_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Affected server identifier."},
        "component": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Affected operational component."},
        "severity": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["low", "medium", "high", "critical"], "external_required": true, "description": "Alert severity inherited from its incident."},
        "alert_type": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Documented threshold-rule category."},
        "metric_name": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Canonical metric evaluated by the rule."},
        "observed_value": {"type": "number", "sqlite_type": "REAL", "nullable": false, "external_required": true, "description": "Observed canonical value at alert creation."},
        "threshold_value": {"type": "number", "sqlite_type": "REAL", "nullable": false, "external_required": true, "description": "Fixed threshold used by the rule."},
        "status": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["open", "acknowledged", "resolved"], "external_required": true, "description": "Alert lifecycle state."},
        "resolved_at": {"type": "datetime", "sqlite_type": "TEXT", "nullable": true, "external_required": false, "description": "Resolution timestamp when present."}
      }
    },
    "maintenance_actions": {
      "description": "Role-labelled historical resolution actions tied to confirmed canonical incidents.",
      "grain": ["action_id"],
      "primary_key": ["action_id"],
      "foreign_keys": [
        {"columns": ["incident_id"], "references_table": "uptime_incidents", "references_columns": ["incident_id"]},
        {"columns": ["facility_id"], "references_table": "facilities", "references_columns": ["facility_id"]},
        {"columns": ["server_id"], "references_table": "servers", "references_columns": ["server_id"]}
      ],
      "recommended_indexes": [["incident_id", "timestamp"], ["facility_id", "timestamp"]],
      "columns": {
        "action_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Stable action identifier."},
        "incident_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Resolved incident identifier."},
        "facility_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Affected facility identifier."},
        "server_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Affected server identifier."},
        "timestamp": {"type": "datetime", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Recorded completion time."},
        "action_type": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Normalized maintenance action category."},
        "description": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Checks or recovery work recorded for the incident."},
        "result": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Conservative result grounded in the confirmed incident classification."},
        "performed_by_role": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["operations_engineer", "network_engineer", "facilities_engineer", "hardware_technician", "application_engineer"], "external_required": true, "description": "Operator role; no personal identity."}
      }
    },
    "detected_anomalies": {
      "description": "Explainable anomalies generated by the governed seasonal-IQR detector.",
      "grain": ["anomaly_id"],
      "primary_key": ["anomaly_id"],
      "foreign_keys": [
        {"columns": ["facility_id"], "references_table": "facilities", "references_columns": ["facility_id"]}
      ],
      "recommended_indexes": [["facility_id", "timestamp"], ["metric_name", "timestamp"], ["severity", "timestamp"]],
      "columns": {
        "anomaly_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Stable detector-output identifier."},
        "timestamp": {"type": "date", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Observation date or month represented by the anomaly."},
        "facility_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Facility represented by the observation."},
        "metric_name": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Canonical metric evaluated."},
        "observed_value": {"type": "number", "sqlite_type": "REAL", "nullable": false, "external_required": true, "description": "Observed source value."},
        "expected_value": {"type": "number", "sqlite_type": "REAL", "nullable": false, "external_required": true, "description": "Seasonal median baseline."},
        "lower_bound": {"type": "number", "sqlite_type": "REAL", "nullable": false, "external_required": true, "description": "Lower Tukey fence."},
        "upper_bound": {"type": "number", "sqlite_type": "REAL", "nullable": false, "external_required": true, "description": "Upper Tukey fence."},
        "deviation_pct": {"type": "number", "sqlite_type": "REAL", "nullable": false, "external_required": true, "description": "Signed deviation from seasonal median."},
        "direction": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["low", "high"], "external_required": true, "description": "Side of the expected range."},
        "severity": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["medium", "high", "critical"], "external_required": true, "description": "Deterministic severity from robust distance."},
        "anomaly_score": {"type": "number", "sqlite_type": "REAL", "nullable": false, "minimum": 0, "external_required": true, "description": "Distance from median measured in robust standard deviations."},
        "method": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["seasonal_iqr"], "external_required": true, "description": "Governed detector method."},
        "source_table": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Canonical observation table."},
        "source_grain": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["facility_day", "facility_month"], "external_required": true, "description": "Aggregation grain evaluated."},
        "source_record_count": {"type": "integer", "sqlite_type": "INTEGER", "nullable": false, "minimum": 0, "external_required": true, "description": "Number of canonical records represented by the observation."}
      }
    },
    "incident_reviews": {
      "description": "Human or explicitly simulated review records; AI hypotheses remain separate from confirmed labels.",
      "grain": ["review_id"],
      "primary_key": ["review_id"],
      "foreign_keys": [
        {"columns": ["incident_id"], "references_table": "uptime_incidents", "references_columns": ["incident_id"]}
      ],
      "recommended_indexes": [["incident_id", "created_at"], ["review_status", "knowledge_update_status"]],
      "columns": {
        "review_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Stable review identifier."},
        "incident_id": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Incident being reviewed."},
        "created_at": {"type": "datetime", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Review creation timestamp."},
        "review_status": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["pending", "confirmed", "rejected"], "external_required": true, "description": "Human-review lifecycle state."},
        "ai_hypothesis": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "external_required": true, "description": "Untrusted diagnostic hypothesis submitted for review."},
        "ai_confidence": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["Low", "Moderate", "High"], "external_required": true, "description": "Deterministically calculated evidence confidence at submission."},
        "human_confirmed_root_cause": {"type": "string", "sqlite_type": "TEXT", "nullable": true, "external_required": false, "description": "Root-cause category entered by the reviewer when confirmed."},
        "resolution_notes": {"type": "string", "sqlite_type": "TEXT", "nullable": true, "external_required": false, "description": "Reviewer-provided resolution evidence."},
        "reviewed_by_role": {"type": "string", "sqlite_type": "TEXT", "nullable": true, "external_required": false, "description": "Reviewer role without personal identity."},
        "reviewed_at": {"type": "datetime", "sqlite_type": "TEXT", "nullable": true, "external_required": false, "description": "Review decision timestamp."},
        "knowledge_update_status": {"type": "string", "sqlite_type": "TEXT", "nullable": false, "allowed_values": ["not_eligible", "pending_review", "approved", "rejected"], "external_required": true, "description": "Separate human decision controlling knowledge eligibility."},
        "simulation": {"type": "integer", "sqlite_type": "INTEGER", "nullable": false, "minimum": 0, "maximum": 1, "external_required": true, "description": "One only for an explicitly simulated portfolio review."}
      }
