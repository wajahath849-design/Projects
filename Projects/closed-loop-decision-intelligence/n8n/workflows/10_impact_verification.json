{
  "id": "cldi10",
  "name": "CLDI 10 - impact_verification",
  "nodes": [
    {
      "id": "10efd7b0-3113-5807-bfff-e352e3393957",
      "name": "Manual start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "f39afb20-1652-515e-a458-ae32164de1b9",
      "name": "Authenticated stage webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "cldi-impact",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "39f3e1d8-f03b-577c-95cc-f1fd4a2d557a",
      "credentials": {
        "httpHeaderAuth": {
          "name": "CLDI Workflow Header"
        }
      }
    },
    {
      "id": "47a183eb-fb56-5ae0-99e8-c7e3b088203d",
      "name": "Run impact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ANALYTICS_API_URL + '/orchestration/impact' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.ANALYTICS_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "45f8cc97-9991-540f-8c9b-d3b66a57b2ca",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "b71ab768-e148-5f53-bc40-c4fbd266f65d",
      "name": "Trigger memory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://n8n:5678/webhook/cldi-memory' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Workflow-Key",
              "value": "={{ $env.ANALYTICS_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Manual start": {
      "main": [
        [
          {
            "node": "Run impact",
