table 'Prediction Detail'
	lineageTag: 7449bf01-2867-4f50-8b49-e078e52d0221

	measure 'Total Images' = DISTINCTCOUNT('Prediction Detail'[BatchID])
		formatString: #,0
		lineageTag: 6740c8e1-de10-49c9-99e3-23d33ffb2c98

	measure 'Total Predictions' = COUNTROWS('Prediction Detail')
		formatString: #,0
		lineageTag: 35401dcc-edcb-4824-97ce-01b4d5de6000

	measure 'Successful Predictions' = CALCULATE(COUNTROWS('Prediction Detail'), 'Prediction Detail'[PredictionStatus] = "Succeeded")
		formatString: #,0
		lineageTag: ec725531-db42-43fc-80e8-cec06048791a

	measure 'Failed Predictions' = COALESCE(CALCULATE(COUNTROWS('Prediction Detail'), 'Prediction Detail'[PredictionStatus] = "Failed"), 0)
		formatString: #,0
		lineageTag: 87adb74e-230d-4231-950a-050e29a39eb6

	measure 'Prediction Success Rate' = DIVIDE([Successful Predictions], [Total Predictions], 0)
		formatString: 0.0%
		lineageTag: 7d2ed2a3-e32b-4955-8be7-39195f2b1fe4

	measure 'Correct Predictions' = COALESCE(CALCULATE(COUNTROWS('Prediction Detail'), 'Prediction Detail'[IsCorrect] = TRUE()), 0)
		formatString: #,0
		lineageTag: 47b9a78a-b60f-4068-84ab-0db68a3a5084

	measure 'Labelled Predictions' = CALCULATE(COUNTROWS('Prediction Detail'), NOT ISBLANK('Prediction Detail'[IsCorrect]))
		formatString: #,0
		lineageTag: 22341e07-b8bd-467f-9ace-875493720ea1

	measure 'Observed Accuracy' = COALESCE(DIVIDE([Correct Predictions], [Labelled Predictions], 0), 0)
		formatString: 0.0%
		lineageTag: 4008fbf4-6353-450e-a6a6-f76d8df3c58e

	measure 'Verified Validation Accuracy' = MAX('Prediction Detail'[ValidationAccuracy])
		formatString: 0.0%
		lineageTag: 77a9954d-9cf7-49c0-8b87-3e0decf3aaf9

	measure 'Model Test Accuracy' = MAX('Prediction Detail'[TestAccuracy])
		formatString: 0.0%
		lineageTag: d95f1cad-0d4c-4bda-976b-6f283ec0bb9f

	measure 'Verified Test Accuracy' = AVERAGEX(VALUES('Prediction Detail'[ModelName]), CALCULATE([Model Test Accuracy]))
		formatString: 0.0%
		lineageTag: 2a57e38c-62c7-4784-ab40-075b0cd03793

	measure 'Average Confidence' = AVERAGE('Prediction Detail'[Confidence])
		formatString: 0.0%
		lineageTag: 810b45c4-56c1-47dc-94ee-0dc529aa343c

	measure 'Average Processing Time' = AVERAGE('Prediction Detail'[ProcessingMilliseconds])
		formatString: #,0.0
		lineageTag: e7d58b2b-495e-4801-87ad-d1f9f004f24f

	measure 'Average Processing Time Display' = FORMAT([Average Processing Time], "#,0.0") & " ms"
		lineageTag: 04f3a4a0-763e-4b20-85cd-b66edf19baa7

	measure 'Average Inference Time' = AVERAGE('Prediction Detail'[InferenceMilliseconds])
		formatString: #,0.0
		lineageTag: acf89f48-b68c-48cf-b7fa-10b428ef8745

	measure 'Prediction-wise Accuracy' =

			VAR CurrentPrediction = MAX('Prediction Detail'[PredictionID])
			RETURN
			    DIVIDE(
			        CALCULATE(
			            [Correct Predictions],
			            FILTER(
			                ALLSELECTED('Prediction Detail'[PredictionID]),
			                'Prediction Detail'[PredictionID] <= CurrentPrediction
			            )
			        ),
			        CALCULATE(
			            [Labelled Predictions],
			            FILTER(
			                ALLSELECTED('Prediction Detail'[PredictionID]),
			                'Prediction Detail'[PredictionID] <= CurrentPrediction
			            )
			        ),
			        0
			    )
		formatString: 0.0%
		lineageTag: fe7ad32e-76bd-436d-942c-1f56263f323a

	measure 'Best Model Name' =

			VAR RankedModels =
			    ADDCOLUMNS(
			        ALL('Prediction Detail'[ModelName]),
			        "__Accuracy", CALCULATE([Model Test Accuracy])
			    )
			RETURN
			    CONCATENATEX(
			        TOPN(1, RankedModels, [__Accuracy], DESC, 'Prediction Detail'[ModelName], ASC),
			        'Prediction Detail'[ModelName],
			        ""
			    )
		lineageTag: 85deec3e-9f09-458d-adc5-f5bc71267f04

	measure 'Best Model Accuracy' =

			VAR RankedModels =
			    ADDCOLUMNS(
			        ALL('Prediction Detail'[ModelName]),
			        "__Accuracy", CALCULATE([Model Test Accuracy])
			    )
			RETURN
			    MAXX(
			        TOPN(1, RankedModels, [__Accuracy], DESC, 'Prediction Detail'[ModelName], ASC),
			        [__Accuracy]
			    )
		formatString: 0.0%
		lineageTag: ff93b190-5ebc-4b40-b23c-640ddf011d46

	measure 'Best Model Prediction' =

			VAR SelectedModel = [Best Model Name]
			VAR LatestPrediction =
			    TOPN(
			        1,
			        FILTER(
			            ALL('Prediction Detail'),
			            'Prediction Detail'[ModelName] = SelectedModel
			                && 'Prediction Detail'[PredictionStatus] = "Succeeded"
			        ),
			        'Prediction Detail'[CreatedAt], DESC,
			        'Prediction Detail'[PredictionID], DESC
			    )
			RETURN
			    CONCATENATEX(LatestPrediction, 'Prediction Detail'[PredictedClass], "")
		lineageTag: 4123e63a-a68c-4bbc-92ef-75f7cc87f7f8

	measure 'Best Model Confidence' =

			VAR SelectedModel = [Best Model Name]
			VAR LatestPrediction =
			    TOPN(
			        1,
			        FILTER(
			            ALL('Prediction Detail'),
			            'Prediction Detail'[ModelName] = SelectedModel
			                && 'Prediction Detail'[PredictionStatus] = "Succeeded"
			        ),
			        'Prediction Detail'[CreatedAt], DESC,
			        'Prediction Detail'[PredictionID], DESC
			    )
			RETURN
			    MAXX(LatestPrediction, 'Prediction Detail'[Confidence])
		formatString: 0.0%
		lineageTag: 4d363514-2f67-4475-934e-3ae1a17edc6e

	measure 'Worst Model Name' =

			VAR RankedModels =
			    ADDCOLUMNS(
			        ALL('Prediction Detail'[ModelName]),
			        "__Accuracy", CALCULATE([Model Test Accuracy])
			    )
			RETURN
			    CONCATENATEX(
			        TOPN(1, RankedModels, [__Accuracy], ASC, 'Prediction Detail'[ModelName], ASC),
			        'Prediction Detail'[ModelName],
			        ""
			    )
		lineageTag: 14ae221d-0746-48ae-933f-db7bf9bc9a22

	measure 'Worst Model Accuracy' =

			VAR RankedModels =
			    ADDCOLUMNS(
			        ALL('Prediction Detail'[ModelName]),
			        "__Accuracy", CALCULATE([Model Test Accuracy])
			    )
			RETURN
			    MAXX(
			        TOPN(1, RankedModels, [__Accuracy], ASC, 'Prediction Detail'[ModelName], ASC),
			        [__Accuracy]
			    )
		formatString: 0.0%
		lineageTag: ebd28e27-aa83-4b88-b0ae-cce99c46fabb

	measure 'Worst Model Prediction' =

			VAR SelectedModel = [Worst Model Name]
			VAR LatestPrediction =
			    TOPN(
			        1,
			        FILTER(
			            ALL('Prediction Detail'),
			            'Prediction Detail'[ModelName] = SelectedModel
			                && 'Prediction Detail'[PredictionStatus] = "Succeeded"
			        ),
			        'Prediction Detail'[CreatedAt], DESC,
			        'Prediction Detail'[PredictionID], DESC
			    )
			RETURN
			    CONCATENATEX(LatestPrediction, 'Prediction Detail'[PredictedClass], "")
		lineageTag: 8280031a-c586-4e6a-9826-fd786240ba1e

	measure 'Worst Model Confidence' =

			VAR SelectedModel = [Worst Model Name]
			VAR LatestPrediction =
			    TOPN(
			        1,
			        FILTER(
			            ALL('Prediction Detail'),
			            'Prediction Detail'[ModelName] = SelectedModel
			                && 'Prediction Detail'[PredictionStatus] = "Succeeded"
			        ),
			        'Prediction Detail'[CreatedAt], DESC,
			        'Prediction Detail'[PredictionID], DESC
			    )
			RETURN
			    MAXX(LatestPrediction, 'Prediction Detail'[Confidence])
		formatString: 0.0%
		lineageTag: 81efd49a-6fb1-4aa9-81c8-d90b5d3c2f70

