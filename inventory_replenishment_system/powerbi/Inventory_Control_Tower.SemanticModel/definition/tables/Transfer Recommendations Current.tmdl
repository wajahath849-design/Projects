table 'Transfer Recommendations Current'

	column model_run_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: model_run_id

	column sku_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: sku_id

	column sku_code
		dataType: string
		summarizeBy: none
		sourceColumn: sku_code

	column from_warehouse_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: from_warehouse_id

	column from_warehouse_code
		dataType: string
		summarizeBy: none
		sourceColumn: from_warehouse_code

	column to_warehouse_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: to_warehouse_id

	column to_warehouse_code
		dataType: string
		summarizeBy: none
		sourceColumn: to_warehouse_code

	column transfer_qty
		dataType: decimal
		formatString: #,##0.00
		summarizeBy: none
		sourceColumn: transfer_qty

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column created_at
		dataType: dateTime
		summarizeBy: none
		sourceColumn: created_at

	partition 'Transfer Recommendations Current' = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(PostgreSQLServer, PostgreSQLDatabase, [CreateNavigationProperties=false]),
				Data = Source{[Schema="inventory", Item="vw_transfer_recommendations_current"]}[Data]
			in
				Data
