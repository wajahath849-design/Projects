	column 'Is Latest Batch' =

			VAR LatestCompletedTime =
			    CALCULATE(
			        MAX('Prediction Detail'[CompletedAt]),
			        ALL('Prediction Detail')
			    )
			RETURN
			    IF(
			        'Prediction Detail'[CompletedAt] = LatestCompletedTime,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 153049e1-fa14-48e6-b036-86e9f4df3abe
		summarizeBy: sum

