table 'Fact Inventory Current'

	column warehouse_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: warehouse_id

	column sku_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: sku_id

	column snapshot_ts
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: snapshot_ts

	column on_hand_qty
		dataType: decimal
		formatString: #,##0.00
		summarizeBy: none
		sourceColumn: on_hand_qty

	column allocated_qty
		dataType: decimal
		formatString: #,##0.00
		summarizeBy: none
		sourceColumn: allocated_qty

	column on_order_qty
		dataType: decimal
		formatString: #,##0.00
		summarizeBy: none
		sourceColumn: on_order_qty

	column backorder_qty
		dataType: decimal
		formatString: #,##0.00
		summarizeBy: none
		sourceColumn: backorder_qty

	column inventory_position_qty
		dataType: decimal
		formatString: #,##0.00
		summarizeBy: none
		sourceColumn: inventory_position_qty

	partition 'Fact Inventory Current' = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(PostgreSQLServer, PostgreSQLDatabase, [CreateNavigationProperties=false]),
				Data = Source{[Schema="inventory", Item="vw_fact_inventory_current"]}[Data]
			in
				Data
