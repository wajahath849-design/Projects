table 'Dim Supplier'

	column supplier_id
		dataType: int64
		isKey
		isHidden
		summarizeBy: none
		sourceColumn: supplier_id

	column supplier_code
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_code

	column supplier_name
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_name

	column contact_email
		dataType: string
		summarizeBy: none
		sourceColumn: contact_email

	column contractual_lead_time_days
		dataType: decimal
		formatString: 0.0
		summarizeBy: none
		sourceColumn: contractual_lead_time_days

	column active
		dataType: boolean
		summarizeBy: none
		sourceColumn: active

	partition 'Dim Supplier' = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(PostgreSQLServer, PostgreSQLDatabase, [CreateNavigationProperties=false]),
				Data = Source{[Schema="inventory", Item="dim_supplier"]}[Data]
			in
				Data
