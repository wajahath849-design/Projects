# Copy this file to .env and add your own key. Never commit .env.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=4096
OLLAMA_SQL_MAX_TOKENS=256
OLLAMA_ANSWER_MAX_TOKENS=256
RAG_TOP_K=4

# Application defaults used in later stages.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=database/datacenter.db
DATASET_ROOT=data
REALTIME_DATABASE_PATH=database/realtime.db
REALTIME_CONFIG_PATH=config/realtime.yaml
