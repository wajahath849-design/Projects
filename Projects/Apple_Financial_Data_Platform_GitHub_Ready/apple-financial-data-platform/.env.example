# SEC requires a descriptive User-Agent containing contact information.
SEC_USER_AGENT=Your Name your.email@example.com
SEC_CIK=0000320193
SEC_COMPANY_NAME=Apple Inc.
SEC_TICKER=AAPL
SEC_REQUEST_TIMEOUT_SECONDS=30
SEC_CACHE_HOURS=12

# SQL Server configuration
MSSQL_SERVER=localhost,1433
MSSQL_DATABASE=AppleFinancialReporting
MSSQL_USERNAME=sa
MSSQL_PASSWORD=ChangeThis_StrongPassword123!
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_WINDOWS_AUTH=false
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# Pipeline defaults
HISTORY_YEARS=10
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
LOG_LEVEL=INFO
