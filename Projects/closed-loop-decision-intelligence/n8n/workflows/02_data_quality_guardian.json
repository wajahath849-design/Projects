{
  "id": "cldi02",
  "name": "CLDI 02 - data_quality_guardian",
  "nodes": [
    {
      "id": "10efd7b0-3113-5807-bfff-e352e3393957",
      "name": "Manual start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "f39afb20-1652-515e-a458-ae32164de1b9",
      "name": "Authenticated stage webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "cldi-quality",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "dddeb7f9-b13d-595c-a168-8760ee7c298a",
      "credentials": {
        "httpHeaderAuth": {
          "name": "CLDI Workflow Header"
        }
      }
    },
    {
      "id": "3e1dcabf-6932-53a4-be0e-64f35ded7520",
      "name": "Run quality",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ANALYTICS_API_URL + '/orchestration/quality' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.ANALYTICS_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "0afca858-c95f-5bc6-b379-3f88d42d17a5",
      "name": "Trigger kpis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://n8n:5678/webhook/cldi-kpis' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Workflow-Key",
              "value": "={{ $env.ANALYTICS_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Manual start": {
      "main": [
        [
          {
            "node": "Run quality",
