            "index": 0
          }
        ]
      ]
    },
    "Run quality": {
      "main": [
        [
          {
            "node": "Trigger kpis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
