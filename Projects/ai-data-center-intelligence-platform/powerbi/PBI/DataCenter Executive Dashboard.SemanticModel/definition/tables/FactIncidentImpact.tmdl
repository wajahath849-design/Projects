	partition FactIncidentImpact = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:/Users/admin/Downloads/AI_Image_Classification_Final_Project_Import_Fixed/ai-data-center-intelligence/data/processed/powerbi_incident_impact_snapshot.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {
				        {"incident_id", type text}, {"incident_date", type date}, {"facility_id", type text},
				        {"facility_name", type text}, {"server_id", type text}, {"severity", type text},
				        {"root_cause", type text}, {"status", type text}, {"downtime_minutes", Int64.Type},
