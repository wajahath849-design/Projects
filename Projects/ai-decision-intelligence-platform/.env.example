APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CONFIG_DIR=config

DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=AIDecisionIntelligence
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes
# For Docker or CI SQL authentication only; leave unset for Windows authentication.
# DB_USERNAME=sa
# DB_PASSWORD=replace-with-a-secret

RANDOM_SEED=42
MODEL_ARTIFACT_PATH=models/artifacts
MLFLOW_TRACKING_URI=mlruns
