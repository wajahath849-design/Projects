// Inventory
Server Count = DISTINCTCOUNT(DimServer[server_id])

Active Server Count =
CALCULATE(
    DISTINCTCOUNT(DimServer[server_id]),
    KEEPFILTERS(DimServer[status] = "active")
)

// Energy
Average PUE = AVERAGE(FactPowerMetrics[pue])

Total Power Draw = SUM(FactPowerMetrics[power_draw_kw])

Total IT Load = SUM(FactPowerMetrics[it_load_kw])

Total Cooling Power = SUM(FactPowerMetrics[cooling_power_kw])

Total Cooling Cost = SUM(FactPowerMetrics[cooling_cost])

// Infrastructure
Average CPU Utilization = AVERAGE(FactServerMetrics[cpu_utilization_pct])

Average Memory Utilization = AVERAGE(FactServerMetrics[memory_utilization_pct])

Average Disk Utilization = AVERAGE(FactServerMetrics[disk_utilization_pct])

Average Server Network Utilization = AVERAGE(FactServerMetrics[network_utilization_pct])

// Network
Average Network Latency = AVERAGE(FactNetworkMetrics[latency_ms])

Average Packet Loss = AVERAGE(FactNetworkMetrics[packet_loss_pct])

Average Throughput = AVERAGE(FactNetworkMetrics[throughput_mbps])

Network Availability = AVERAGE(FactNetworkMetrics[network_availability_pct])

// Reliability
Total Downtime = SUM(FactIncidents[downtime_minutes])

Incident Count = DISTINCTCOUNT(FactIncidents[incident_id])

Downtime per Server = DIVIDE([Total Downtime], [Server Count])

Incident Rate per 100 Servers = DIVIDE([Incident Count], [Server Count]) * 100

Visible Days = DISTINCTCOUNT(DimDate[Date])

Operational Availability =
VAR PotentialServerMinutes = [Server Count] * [Visible Days] * 1440
RETURN
    100 * (1 - DIVIDE([Total Downtime], PotentialServerMinutes))

// Time intelligence
Previous Year Average PUE =
CALCULATE([Average PUE], DATEADD(DimDate[Date], -1, YEAR))

Year-over-Year PUE Change =
DIVIDE([Average PUE] - [Previous Year Average PUE], [Previous Year Average PUE])

Previous Year Cooling Cost =
CALCULATE([Total Cooling Cost], DATEADD(DimDate[Date], -1, YEAR))

Year-over-Year Cooling Cost Change =
DIVIDE([Total Cooling Cost] - [Previous Year Cooling Cost], [Previous Year Cooling Cost])

Previous Year Downtime =
CALCULATE([Total Downtime], DATEADD(DimDate[Date], -1, YEAR))

Year-over-Year Downtime Change =
DIVIDE([Total Downtime] - [Previous Year Downtime], [Previous Year Downtime])

Latest Data Date =
MAXX(
    UNION(
        SELECTCOLUMNS(FactPowerMetrics, "DataDate", FactPowerMetrics[timestamp]),
        SELECTCOLUMNS(FactNetworkMetrics, "DataDate", FactNetworkMetrics[timestamp]),
        SELECTCOLUMNS(FactServerMetrics, "DataDate", FactServerMetrics[timestamp])
    ),
    [DataDate]
)

// Incident intelligence
Log Count = DISTINCTCOUNT(FactSystemLogs[log_id])

Error Log Count =
CALCULATE(
    [Log Count],
    KEEPFILTERS(FactSystemLogs[log_level] IN {"ERROR", "CRITICAL"})
)

Critical Log Count =
CALCULATE([Log Count], KEEPFILTERS(FactSystemLogs[log_level] = "CRITICAL"))

Alert Count = DISTINCTCOUNT(FactAlerts[alert_id])

Critical Alert Count =
CALCULATE([Alert Count], KEEPFILTERS(FactAlerts[severity] = "critical"))

Open Alert Count =
CALCULATE([Alert Count], KEEPFILTERS(FactAlerts[status] = "open"))

Anomaly Count = DISTINCTCOUNT(FactAnomalies[anomaly_id])

Critical Anomaly Count =
CALCULATE([Anomaly Count], KEEPFILTERS(FactAnomalies[severity] = "critical"))

Maintenance Action Count = DISTINCTCOUNT(FactMaintenanceActions[action_id])

MTTR Minutes = AVERAGE(FactIncidents[downtime_minutes])

// Predictive operations
Average Server Risk Score = AVERAGE(FactServerRisk[risk_score])

High Risk Server Count =
CALCULATE(
    DISTINCTCOUNT(FactServerRisk[server_id]),
    KEEPFILTERS(FactServerRisk[risk_level] IN {"high", "critical"})
)

Average Facility Health Score = AVERAGE(FactFacilityHealth[health_score])

Server Risk Observation Count = COUNTROWS(FactServerRisk)

// Governed cost and carbon snapshot
Modeled Energy = SUM(FactCostCarbon[modeled_energy_kwh])

Modeled Energy Cost = SUM(FactCostCarbon[modeled_energy_cost_usd])

Modeled Cooling Cost = SUM(FactCostCarbon[modeled_cooling_cost_usd])

Modeled Carbon = SUM(FactCostCarbon[modeled_carbon_tonnes])

Average Energy Price = AVERAGE(FactCostCarbon[price_per_kwh])

Average Carbon Intensity = AVERAGE(FactCostCarbon[grams_co2e_per_kwh])

Average Efficiency Opportunity Score =
AVERAGE(FactCostCarbon[efficiency_opportunity_score])

// Descriptive incident impact snapshot
Incident Impact Count = DISTINCTCOUNT(FactIncidentImpact[incident_id])

Average Incident PUE Change = AVERAGE(FactIncidentImpact[change_pue_pct])

Average Incident Latency Change = AVERAGE(FactIncidentImpact[change_latency_ms_pct])

Modeled Downtime Cost Exposure =
SUM(FactIncidentImpact[modeled_downtime_cost_exposure_usd])

// Latest bounded live-operations snapshot
Live Facility Health Score = AVERAGE(FactLiveOperationsSnapshot[health_score])

Live Active Alert Count = SUM(FactLiveOperationsSnapshot[active_alert_count])

Live Data Completeness = AVERAGE(FactLiveOperationsSnapshot[data_completeness_pct])
