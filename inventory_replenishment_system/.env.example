POSTGRES_DB=inventory
POSTGRES_USER=inventory_app
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://inventory_app:change_me@localhost:5432/inventory
API_KEY=replace-with-a-long-random-key
LOG_LEVEL=INFO
FORECAST_HORIZON_DAYS=90
MIN_TRAINING_DAYS=90
DEFAULT_SERVICE_LEVEL=0.95
PIPELINE_POLL_SECONDS=15
JOB_HEARTBEAT_SECONDS=30
JOB_STALE_MINUTES=30
EXTERNAL_API_ALLOWED_HOSTS=api.open-meteo.com
ALLOWED_INGESTION_ROOTS=/app/sample_data,/app/runtime
