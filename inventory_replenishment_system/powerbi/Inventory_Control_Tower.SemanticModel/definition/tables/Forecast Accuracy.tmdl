table 'Forecast Accuracy'

	column model_run_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: model_run_id

	column metric_date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: metric_date

	column warehouse_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: warehouse_id

	column warehouse_code
		dataType: string
		summarizeBy: none
		sourceColumn: warehouse_code

	column sku_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: sku_id

	column sku_code
		dataType: string
		summarizeBy: none
		sourceColumn: sku_code

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column mae
		dataType: decimal
		formatString: 0.00
		summarizeBy: none
		sourceColumn: mae

	column rmse
		dataType: decimal
		formatString: 0.00
		summarizeBy: none
		sourceColumn: rmse

	column wape
		dataType: decimal
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: wape

	column bias
		dataType: decimal
		summarizeBy: none
		sourceColumn: bias

	column sample_count
		dataType: int64
		summarizeBy: none
		sourceColumn: sample_count

	column absolute_error_sum
		dataType: decimal
		summarizeBy: none
		sourceColumn: absolute_error_sum

	column actual_sum
		dataType: decimal
		summarizeBy: none
		sourceColumn: actual_sum

	column forecast_sum
		dataType: decimal
		summarizeBy: none
		sourceColumn: forecast_sum

	column model_name
		dataType: string
		summarizeBy: none
		sourceColumn: model_name

	column model_version
		dataType: string
		summarizeBy: none
		sourceColumn: model_version

	partition 'Forecast Accuracy' = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(PostgreSQLServer, PostgreSQLDatabase, [CreateNavigationProperties=false]),
				Data = Source{[Schema="inventory", Item="vw_forecast_accuracy"]}[Data]
			in
				Data
