table FactPowerMetrics

	column metric_id
		dataType: string
		isNullable: false
		summarizeBy: none
		sourceColumn: metric_id

		annotation SummarizationSetBy = Automatic

	column facility_id
		dataType: string
		isNullable: false
		summarizeBy: none
		sourceColumn: facility_id

		annotation SummarizationSetBy = Automatic

	column timestamp
		dataType: dateTime
		isNullable: false
		summarizeBy: none
		sourceColumn: timestamp

		annotation SummarizationSetBy = Automatic

	column power_draw_kw
		dataType: double
		isNullable: false
		summarizeBy: none
		sourceColumn: power_draw_kw

