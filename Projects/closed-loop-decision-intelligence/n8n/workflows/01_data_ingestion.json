{
  "id": "cldi01",
  "name": "CLDI 01 - data_ingestion",
  "nodes": [
    {
      "id": "10efd7b0-3113-5807-bfff-e352e3393957",
      "name": "Manual start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "f39afb20-1652-515e-a458-ae32164de1b9",
      "name": "Authenticated stage webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "cldi-ingestion",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "803de336-40b6-58e8-909d-dbad621c295b",
      "credentials": {
        "httpHeaderAuth": {
          "name": "CLDI Workflow Header"
        }
      }
    },
    {
      "id": "9be9b608-734c-565a-b856-7772a6b8ba38",
      "name": "Run ingestion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ANALYTICS_API_URL + '/orchestration/ingestion' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.ANALYTICS_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "45f8cc97-9991-540f-8c9b-d3b66a57b2ca",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      }
    },
    {
      "id": "f5f47d39-98d1-5a3d-96be-3f61c8b091b9",
      "name": "Trigger quality",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://n8n:5678/webhook/cldi-quality' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Workflow-Key",
              "value": "={{ $env.ANALYTICS_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Manual start": {
      "main": [
        [
          {
            "node": "Run ingestion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authenticated stage webhook": {
      "main": [
        [
          {
            "node": "Run ingestion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule": {
      "main": [
        [
          {
            "node": "Run ingestion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run ingestion": {
      "main": [
        [
          {
            "node": "Trigger quality",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "timezone": "UTC"
  },
  "pinData": {},
  "tags": []
}
