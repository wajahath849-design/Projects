model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["ProjectMetrics","AuditIssues","AuditSources","AuditSummary","ExpenseDrivers","ForecastMonthly","MonthlyFinance"]

annotation PBI_ProTooling = ["DevMode"]

ref table ProjectMetrics
ref table AuditIssues
ref table AuditSources
ref table AuditSummary
ref table ExpenseDrivers
ref table ForecastMonthly
ref table MonthlyFinance

ref cultureInfo en-GB
