table 'Dim Date'

	column date_value
		dataType: dateTime
		isKey
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date_value

	column date_key
		dataType: int64
		summarizeBy: none
		sourceColumn: date_key

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: int64
		summarizeBy: none
		sourceColumn: quarter

	column month_number
		dataType: int64
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		sortByColumn: month_number
		summarizeBy: none
		sourceColumn: month_name

	column week_of_year
		dataType: int64
		summarizeBy: none
		sourceColumn: week_of_year

	column day_of_month
		dataType: int64
		summarizeBy: none
		sourceColumn: day_of_month

	column day_of_week
		dataType: int64
		summarizeBy: none
		sourceColumn: day_of_week

	column day_name
		dataType: string
		sortByColumn: day_of_week
		summarizeBy: none
		sourceColumn: day_name

	column is_weekend
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

	partition 'Dim Date' = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(PostgreSQLServer, PostgreSQLDatabase, [CreateNavigationProperties=false]),
				Data = Source{[Schema="inventory", Item="dim_date"]}[Data]
			in
				Data
