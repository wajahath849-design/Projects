table _Measures
	lineageTag: 56cada75-0f8f-4876-a554-ef22b2503fa6

	measure 'Total Prediction Runs' =

			CALCULATE(
			    COUNTROWS(ModelPrediction),
			    ImageBatch[MetricsEligible] = TRUE()
			)
		formatString: #,0
		lineageTag: e9eda185-3b2a-4ab8-901d-6aa47a23de1f

	measure 'Enabled Models' =

			CALCULATE(
			    COUNTROWS(ModelRegistry),
			    ModelRegistry[IsEnabled] = TRUE()
			)
		formatString: 0
		lineageTag: 14b3b07c-fc88-4311-a4ae-bfa358b24f78

	measure 'KPI Total Images' =

			CALCULATE(
			    DISTINCTCOUNT(ImageBatch[BatchID]),
			    ImageBatch[MetricsEligible] = TRUE()
			)
		formatString: #,0
		lineageTag: ad5d8b67-0dc9-4aaa-b9c4-abb95d5f99cd

	measure 'KPI Prediction Runs' =

			CALCULATE(
			    COUNTROWS(ModelPrediction),
			    ImageBatch[MetricsEligible] = TRUE()
			)
		formatString: #,0
		lineageTag: f2d46ca6-8ac6-4191-8bcf-6b2b0f3d61b9

	measure 'KPI Successful Predictions' =

			CALCULATE(
			    COUNTROWS(ModelPrediction),
			    ImageBatch[MetricsEligible] = TRUE(),
			    ModelPrediction[PredictionStatus] = "Succeeded"
			)
		formatString: #,0
		lineageTag: 26308324-a635-48ad-a2df-7826cad36f3a

	measure 'KPI Success Rate' =

			DIVIDE(
			    [KPI Successful Predictions],
			    [KPI Prediction Runs],
			    0
			)
		formatString: 0.0%
		lineageTag: 48d419b5-8abe-463a-abcb-2144694be1f0

	measure 'KPI Average Confidence' =

			CALCULATE(
			    AVERAGE(ModelPrediction[Confidence]),
			    ImageBatch[MetricsEligible] = TRUE(),
			    ModelPrediction[PredictionStatus] = "Succeeded"
			)
		formatString: 0.0%
		lineageTag: 52213d0e-a702-4be4-8f89-e3f6190ba480

	measure 'Latest Batch ID' =

			VAR LatestBatchRow =
			    TOPN(
			        1,
			        FILTER(
			            ALL(ImageBatch),
			            ImageBatch[MetricsEligible] = TRUE()
			                && ImageBatch[ProcessingStatus] IN {"Completed", "PartialSuccess"}
			                && NOT ISBLANK(ImageBatch[CompletedAt])
			        ),
			        ImageBatch[CompletedAt], DESC,
			        ImageBatch[BatchID], DESC
			    )
			RETURN
			    CONCATENATEX(
			        LatestBatchRow,
			        ImageBatch[BatchID],
			        ""
			    )
		lineageTag: 938c8109-a301-453e-bb3b-33b22b0eb6cb

	measure 'Latest Model Prediction' =

			VAR LatestBatchRow =
			    TOPN(
			        1,
			        FILTER(
			            ALL(ImageBatch),
			            ImageBatch[MetricsEligible] = TRUE()
			                && ImageBatch[ProcessingStatus] IN {"Completed", "PartialSuccess"}
			                && NOT ISBLANK(ImageBatch[CompletedAt])
			        ),
			        ImageBatch[CompletedAt], DESC,
			        ImageBatch[BatchID], DESC
			    )
			RETURN
			    CALCULATE(
			        SELECTEDVALUE(ModelPrediction[PredictedClass]),
			        REMOVEFILTERS(ImageBatch),
			        LatestBatchRow,
			        ModelPrediction[PredictionStatus] = "Succeeded"
			    )
		lineageTag: 261069de-c495-45dc-8588-9c410162d375

	measure 'Latest Model Confidence' =

			VAR LatestBatchRow =
			    TOPN(
			        1,
			        FILTER(
			            ALL(ImageBatch),
			            ImageBatch[MetricsEligible] = TRUE()
			                && ImageBatch[ProcessingStatus] IN {"Completed", "PartialSuccess"}
			                && NOT ISBLANK(ImageBatch[CompletedAt])
			        ),
			        ImageBatch[CompletedAt], DESC,
			        ImageBatch[BatchID], DESC
			    )
			RETURN
			    CALCULATE(
			        MAX(ModelPrediction[Confidence]),
			        REMOVEFILTERS(ImageBatch),
			        LatestBatchRow,
			        ModelPrediction[PredictionStatus] = "Succeeded"
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8805c5c5-8138-4e88-9793-6178b98fb146

	measure 'Latest Model Inference Time' =

			VAR LatestBatchRow =
			    TOPN(
			        1,
			        FILTER(
			            ALL(ImageBatch),
			            ImageBatch[MetricsEligible] = TRUE()
			                && ImageBatch[ProcessingStatus] IN {"Completed", "PartialSuccess"}
			                && NOT ISBLANK(ImageBatch[CompletedAt])
			        ),
			        ImageBatch[CompletedAt], DESC,
			        ImageBatch[BatchID], DESC
			    )
			RETURN
			    CALCULATE(
			        MAX(ModelPrediction[InferenceMilliseconds]),
			        REMOVEFILTERS(ImageBatch),
			        LatestBatchRow,
			        ModelPrediction[PredictionStatus] = "Succeeded"
			    )
		formatString: #,0.0 "ms"
		lineageTag: 67248c49-cf8b-4a78-a140-204dbc7604c6

	measure 'Latest Model Status' =

			VAR LatestBatchRow =
			    TOPN(
			        1,
			        FILTER(
			            ALL(ImageBatch),
			            ImageBatch[MetricsEligible] = TRUE()
			                && ImageBatch[ProcessingStatus] IN {"Completed", "PartialSuccess"}
			                && NOT ISBLANK(ImageBatch[CompletedAt])
			        ),
			        ImageBatch[CompletedAt], DESC,
			        ImageBatch[BatchID], DESC
			    )
			RETURN
			    CALCULATE(
			        SELECTEDVALUE(ModelPrediction[PredictionStatus]),
			        REMOVEFILTERS(ImageBatch),
			        LatestBatchRow
			    )
		lineageTag: 0c59ad57-6cf4-49b5-9411-3b741c575b3c

	measure 'KPI Average Processing Time' =

			CALCULATE(
			    AVERAGE(ImageBatch[ProcessingMilliseconds]),
			    ImageBatch[MetricsEligible] = TRUE(),
			    ImageBatch[ProcessingStatus] IN {"Completed", "PartialSuccess"}
			)
		formatString: #,0.0 "ms"
		lineageTag: 42181ab7-34a8-4ce5-81e3-cf7f432d5c0a

	measure 'KPI Correct Predictions' =

			CALCULATE(
			    COUNTROWS(ModelPrediction),
			    ImageBatch[MetricsEligible] = TRUE(),
			    ModelPrediction[IsCorrect] = TRUE()
			)
		formatString: #,0
		lineageTag: d629586d-08f4-430e-9084-a34560910278

	measure 'KPI Labelled Predictions' =

			CALCULATE(
			    COUNTROWS(ModelPrediction),
			    ImageBatch[MetricsEligible] = TRUE(),
			    NOT ISBLANK(ModelPrediction[IsCorrect])
			)
		formatString: #,0
		lineageTag: a590f729-08b2-44b4-b37d-db9f07d8dfb1

	measure 'KPI Observed Accuracy' =

			DIVIDE(
			    [KPI Correct Predictions],
			    [KPI Labelled Predictions],
			    0
			)
		formatString: 0.0%
		lineageTag: fad247ac-e163-41a1-95d5-834238ef207f

	measure 'Latest Processing Status' =

			VAR LatestBatchRow =
			    TOPN(
			        1,
			        FILTER(
			            ALL(ImageBatch),
			            ImageBatch[MetricsEligible] = TRUE()
			                && ImageBatch[ProcessingStatus] IN {"Completed", "PartialSuccess"}
			                && NOT ISBLANK(ImageBatch[CompletedAt])
			        ),
			        ImageBatch[CompletedAt], DESC,
			        ImageBatch[BatchID], DESC
			    )
			RETURN
			    MAXX(LatestBatchRow, ImageBatch[ProcessingStatus])
		lineageTag: 5231e883-281e-4949-a3c2-407affdfe7e7

	measure 'Latest Batch Consensus Digit' =

			VAR LatestBatchRow =
			    TOPN(
			        1,
			        FILTER(
			            ALL(ImageBatch),
			            ImageBatch[MetricsEligible] = TRUE()
			                && ImageBatch[ProcessingStatus] IN {"Completed", "PartialSuccess"}
			                && NOT ISBLANK(ImageBatch[CompletedAt])
			        ),
			        ImageBatch[CompletedAt], DESC,
			        ImageBatch[BatchID], DESC
			    )
			VAR CurrentPredictions =
			    CALCULATETABLE(
			        ModelPrediction,
			        REMOVEFILTERS(ImageBatch),
			        REMOVEFILTERS(ModelRegistry),
			        LatestBatchRow,
			        ModelPrediction[PredictionStatus] = "Succeeded"
			    )
			VAR VoteTable =
			    GROUPBY(
			        CurrentPredictions,
			        ModelPrediction[PredictedClass],
			        "__Votes", COUNTX(CURRENTGROUP(), 1),
			        "__AverageConfidence", AVERAGEX(CURRENTGROUP(), ModelPrediction[Confidence])
			    )
			RETURN
			    CONCATENATEX(
			        TOPN(
			            1,
			            VoteTable,
			            [__Votes], DESC,
			            [__AverageConfidence], DESC,
			            ModelPrediction[PredictedClass], ASC
			        ),
			        ModelPrediction[PredictedClass],
			        ""
			    )
		lineageTag: 327bd020-4902-4ae5-90ab-064790436f95

	measure 'Latest Batch Observed Accuracy' =

			VAR LatestBatchRow =
			    TOPN(
			        1,
			        FILTER(
			            ALL(ImageBatch),
			            ImageBatch[MetricsEligible] = TRUE()
			                && ImageBatch[ProcessingStatus] IN {"Completed", "PartialSuccess"}
			                && NOT ISBLANK(ImageBatch[CompletedAt])
			        ),
			        ImageBatch[CompletedAt], DESC,
			        ImageBatch[BatchID], DESC
			    )
			VAR CorrectPredictions =
			    CALCULATE(
			        COUNTROWS(ModelPrediction),
			        REMOVEFILTERS(ImageBatch),
			        REMOVEFILTERS(ModelRegistry),
			        LatestBatchRow,
			        ModelPrediction[IsCorrect] = TRUE()
			    )
			VAR LabelledPredictions =
			    CALCULATE(
			        COUNTROWS(ModelPrediction),
			        REMOVEFILTERS(ImageBatch),
			        REMOVEFILTERS(ModelRegistry),
			        LatestBatchRow,
			        NOT ISBLANK(ModelPrediction[IsCorrect])
			    )
			RETURN
			    DIVIDE(CorrectPredictions, LabelledPredictions, 0)
		formatString: 0.0%
		lineageTag: 8bc2df3e-b4fa-4af3-bd2d-73bbfe899c80

	column 'Measure Group'
		isHidden
		lineageTag: 592ee360-bddf-40a2-80a0-693387af0b98
		summarizeBy: none
		isNameInferred
		sourceColumn: [Measure Group]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source =

				DATATABLE(
				    "Measure Group", STRING,
				    {
				        {"Executive Overview"}
				    }
				)

	annotation PBI_Id = 471f1e7f241a4507a46101de34b746e2
