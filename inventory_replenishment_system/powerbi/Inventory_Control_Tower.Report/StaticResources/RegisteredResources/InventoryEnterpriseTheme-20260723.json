{
  "name": "Inventory Enterprise Control Tower",
  "dataColors": [
    "#1F77B4",
    "#00A6A6",
    "#F59E0B",
    "#DC2626",
    "#7C3AED",
    "#16A34A",
    "#EC4899",
    "#64748B"
  ],
  "background": "#F4F7FB",
  "foreground": "#1F2937",
  "tableAccent": "#17365D",
  "maximum": "#16A34A",
  "minimum": "#DC2626",
  "null": "#94A3B8",
  "textClasses": {
    "label": {
      "color": "#64748B",
      "fontSize": 10,
      "fontFace": "Segoe UI"
    },
    "callout": {
      "color": "#17365D",
      "fontSize": 20,
      "fontFace": "Segoe UI",
      "fontWeight": "bold"
    },
    "title": {
      "color": "#1F2937",
      "fontSize": 12,
      "fontFace": "Segoe UI",
      "fontWeight": "bold"
    },
    "header": {
      "color": "#1F2937",
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "fontWeight": "semibold"
    },
    "largeTitle": {
      "color": "#17365D",
      "fontSize": 18,
      "fontFace": "Segoe UI",
      "fontWeight": "bold"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "fontFamily": [
          {
            "value": "Segoe UI"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit"
          }
        ]
      }
    }
  }
}