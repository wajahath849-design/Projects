-- Create this disconnected table in the model (Import storage mode):
-- Scenario Demand Spike = SELECTCOLUMNS(GENERATESERIES(0.5, 2.0, 0.05), "Multiplier", [Value])

Scenario Multiplier =
SELECTEDVALUE('Scenario Demand Spike'[Multiplier], 1.0)

Current On Hand =
SUM('Fact Inventory Current'[on_hand_qty])

Allocated Quantity =
SUM('Fact Inventory Current'[allocated_qty])

On Order Quantity =
SUM('Fact Inventory Current'[on_order_qty])

Backorder Quantity =
SUM('Fact Inventory Current'[backorder_qty])

Inventory Position =
SUM('Fact Inventory Current'[inventory_position_qty])

Inventory Value =
SUMX(
    'Fact Inventory Current',
    'Fact Inventory Current'[on_hand_qty] * RELATED('Dim SKU'[unit_cost])
)

Forecast Demand =
SUM('Fact Forecast Current'[forecast_qty])

Adjusted Forecast Demand =
[Forecast Demand] * [Scenario Multiplier]

Forecast Demand Next 30 Days =
VAR StartDate = TODAY()
RETURN
CALCULATE(
    [Adjusted Forecast Demand],
    DATESBETWEEN('Dim Date'[date_value], StartDate, StartDate + 29)
)

Forecast Demand Next 90 Days =
VAR StartDate = TODAY()
RETURN
CALCULATE(
    [Adjusted Forecast Demand],
    DATESBETWEEN('Dim Date'[date_value], StartDate, StartDate + 89)
)

Days of Supply Remaining =
VAR Stock = [Inventory Position]
VAR StartDate = TODAY()
VAR EndDate = StartDate + 90
VAR FutureDates =
    FILTER(
        ALL('Dim Date'[date_value]),
        'Dim Date'[date_value] >= StartDate &&
        'Dim Date'[date_value] <= EndDate
    )
VAR StockoutDate =
    MINX(
        FILTER(
            FutureDates,
            VAR CurrentDate = 'Dim Date'[date_value]
            VAR CumulativeDemand =
                CALCULATE(
                    [Adjusted Forecast Demand],
                    FILTER(
                        ALL('Dim Date'[date_value]),
                        'Dim Date'[date_value] >= StartDate &&
                        'Dim Date'[date_value] <= CurrentDate
                    )
                )
            RETURN CumulativeDemand >= Stock
        ),
        'Dim Date'[date_value]
    )
RETURN
SWITCH(
    TRUE(),
    Stock <= 0, 0,
    ISBLANK(StockoutDate), 90,
    DATEDIFF(StartDate, StockoutDate, DAY)
)

Recommended Order Quantity =
SUM('Fact Replenishment Current'[recommended_order_qty])

Reorder Point =
SUM('Fact Replenishment Current'[reorder_point_qty])

Safety Stock =
SUM('Fact Replenishment Current'[safety_stock_qty])

Average Lead Time Days =
AVERAGE('Fact Replenishment Current'[avg_lead_time_days])

Critical SKU Count =
CALCULATE(
    DISTINCTCOUNT('Fact Replenishment Current'[sku_id]),
    'Fact Replenishment Current'[risk_band] = "CRITICAL"
)

High Risk SKU Count =
CALCULATE(
    DISTINCTCOUNT('Fact Replenishment Current'[sku_id]),
    'Fact Replenishment Current'[risk_band] IN {"CRITICAL", "HIGH"}
)

Reorder Status =
VAR DOS = [Days of Supply Remaining]
VAR LeadTime = [Average Lead Time Days]
VAR Position = [Inventory Position]
VAR ROP = [Reorder Point]
RETURN
SWITCH(
    TRUE(),
    Position <= 0, "STOCKOUT",
    Position <= ROP || DOS <= LeadTime, "REORDER NOW",
    DOS <= LeadTime + 7, "REVIEW",
    "OK"
)

Risk Sort =
SWITCH(
    SELECTEDVALUE('Fact Replenishment Current'[risk_band]),
    "CRITICAL", 1,
    "HIGH", 2,
    "MEDIUM", 3,
    "LOW", 4,
    5
)

Actual Demand =
SUM('Fact Daily Demand'[demand_qty])

Actual Demand Value =
SUM('Fact Daily Demand'[demand_value])

Forecast WAPE =
DIVIDE(
    SUM('Forecast Accuracy'[absolute_error_sum]),
    SUM('Forecast Accuracy'[actual_sum])
)

Forecast Bias =
DIVIDE(
    SUM('Forecast Accuracy'[forecast_sum]) - SUM('Forecast Accuracy'[actual_sum]),
    SUM('Forecast Accuracy'[actual_sum])
)

Forecast Bias Units =
DIVIDE(
    SUMX(
        'Forecast Accuracy',
        'Forecast Accuracy'[bias] * 'Forecast Accuracy'[sample_count]
    ),
    SUM('Forecast Accuracy'[sample_count])
)

On-Time Delivery Rate =
DIVIDE(
    SUMX(
        'Supplier Performance',
        'Supplier Performance'[on_time_delivery_rate] * 'Supplier Performance'[on_time_eligible_order_lines]
    ),
    SUM('Supplier Performance'[on_time_eligible_order_lines])
)

Average SLA Variance Days =
DIVIDE(
    SUMX(
        'Supplier Performance',
        'Supplier Performance'[avg_sla_variance_days] * 'Supplier Performance'[completed_order_lines]
    ),
    SUM('Supplier Performance'[completed_order_lines])
)

Historical Inventory Value =
SUMX(
    'Fact Inventory Daily',
    'Fact Inventory Daily'[on_hand_qty] * RELATED('Dim SKU'[unit_cost])
)

Average Inventory Value 365D =
VAR EndDate = MAX('Dim Date'[date_value])
RETURN
AVERAGEX(
    DATESINPERIOD('Dim Date'[date_value], EndDate, -365, DAY),
    CALCULATE([Historical Inventory Value])
)

Inventory Turns 365D =
VAR EndDate = MAX('Dim Date'[date_value])
VAR DemandValue365 =
    CALCULATE(
        [Actual Demand Value],
        DATESINPERIOD('Dim Date'[date_value], EndDate, -365, DAY)
    )
RETURN
DIVIDE(DemandValue365, [Average Inventory Value 365D])

Latest Model Run ID =
MAX('Fact Forecast Current'[model_run_id])

Latest Forecast WAPE =
VAR LatestRun = [Latest Model Run ID]
RETURN
CALCULATE(
    [Forecast WAPE],
    'Forecast Accuracy'[model_run_id] = LatestRun
)

Latest Forecast Bias =
VAR LatestRun = [Latest Model Run ID]
RETURN
CALCULATE(
    [Forecast Bias],
    'Forecast Accuracy'[model_run_id] = LatestRun
)

Gross Purchase Requirement =
SUM('Fact Replenishment Current'[gross_recommended_order_qty])

Internal Transfer Quantity =
SUM('Transfer Recommendations Current'[transfer_qty])

Net External Purchase Quantity =
[Recommended Order Quantity]
